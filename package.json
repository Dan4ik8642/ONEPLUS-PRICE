{
  "name": "oneplus-price",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --configLoader runner",
    "coverage": "vitest run --configLoader runner --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:production": "node scripts/seed-production.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "nuxt": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "read-excel-file": "^5.8.8",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
